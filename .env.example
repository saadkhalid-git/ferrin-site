# Copy to .env and fill in. Never commit .env.

# PostgreSQL (used by docker-compose.yml and by the app)
POSTGRES_USER=ferrin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ferrin
DATABASE_URL=postgresql://ferrin:change-me@127.0.0.1:5432/ferrin?schema=public

# At least 32 random characters. Generate one with: openssl rand -base64 48
AUTH_SECRET=

# Public address of the app, used for the admin CSRF check and absolute links
APPLICATION_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# Optional: used once by `npm run admin:create` to create the first administrator.
# Remove the password from .env after the account exists.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Copy to deploy/.env on the server and fill in. Never commit it. chmod 600 deploy/.env
POSTGRES_USER=ferrin
POSTGRES_PASSWORD=            # openssl rand -hex 24
POSTGRES_DB=ferrin
DATABASE_URL=postgresql://ferrin:<POSTGRES_PASSWORD>@db:5432/ferrin?schema=public

AUTH_SECRET=                  # openssl rand -base64 48
APPLICATION_URL=https://<your-address>   # the public https address (tunnel or your domain)

# Cloudflare Tunnel. Empty = temporary trycloudflare.com address.
TUNNEL_TOKEN=
# TUNNEL_COMMAND=tunnel --no-autoupdate run

# Owner of backup files (id -u / id -g on the server)
HOST_UID=1000
HOST_GID=1000

# Used once by scripts/create-admin.mjs inside the app container
ADMIN_NAME=Site admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

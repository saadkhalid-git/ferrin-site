{
  "name": "ferrin-site",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Ferrin Instruments: static B2B shop for salon, barber and grooming instruments",
  "scripts": {
    "build": "node build.mjs",
    "build:assets": "BASE_PATH= node build.mjs --assets",
    "check": "node scripts/check-i18n.mjs && node scripts/check-language.mjs && node scripts/check-site.mjs",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "admin:create": "node scripts/create-admin.mjs",
    "dev": "node --watch-path=server --watch-path=src server/index.js",
    "start": "NODE_ENV=production node server/index.js",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "prisma": "^6.19.3",
    "sharp": "^0.35.4"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.4",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/client": "^6.19.3",
    "dotenv": "^18.0.4",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  }
}
